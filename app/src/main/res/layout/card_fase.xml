<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="fase"
            type="com.example.ediltrack.model.uimodel.FaseUI" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bordo_card"
        android:padding="2dp"
        android:layout_marginBottom="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:backgroundTint="@android:color/white">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <EditText
                    android:id="@+id/numero"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:hint="N°"
                    android:inputType="number"
                    android:text="@={fase.numeroFase}"
                    android:textSize="16sp"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/titolo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/titolo"
                    android:text="@={fase.titolo}"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:inputType="textCapSentences"
                    app:layout_constraintStart_toEndOf="@id/numero"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/numero"/>

                <EditText
                    android:id="@+id/descrizione"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/descrizione"
                    android:text="@={fase.descrizione}"
                    android:textSize="16sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="1"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    app:layout_constraintTop_toBottomOf="@id/numero"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/descrizione"/>

                <CheckBox
                    android:id="@+id/check_terminata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminata"
                    android:textSize="14sp"
                    android:checked="@={fase.terminata}"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <Button
                    android:id="@+id/btnEliminaFase"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elimina"
                    android:textColor="@android:color/holo_red_dark"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="@android:color/holo_red_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/check_terminata"
                    app:layout_constraintBottom_toBottomOf="@id/check_terminata"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</layout>