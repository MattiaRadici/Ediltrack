<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.ediltrack.ui.viewmodel.SingoloCantViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5">

        <ImageView
            android:id="@+id/img_dett_cant"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-20dp"
            app:layout_constraintTop_toBottomOf="@id/img_dett_cant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:contentPadding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nome_cant_dett"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.nome}"
                            tools:text="Cantiere Via Roma"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_marginBottom="20dp"/>

                        <TextView
                            android:id="@+id/label_luogo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/luogo"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#757575"/>
                        <TextView
                            android:id="@+id/luogo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.luogo}"
                            android:textSize="20sp"
                            android:textColor="@android:color/black"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/label_capocantiere_dett"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/capocantiere"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#757575"/>
                        <TextView
                            android:id="@+id/capocantiere"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.nomeCapocant}"
                            android:textSize="20sp"
                            android:textColor="@android:color/black"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_modifica_capocantiere"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modifica"
                            android:textSize="12sp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="12dp"
                            app:icon="@android:drawable/ic_menu_edit"
                            app:iconSize="14dp"
                            app:iconPadding="4dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:id="@+id/label_operai_dett"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dipendenti"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#757575"/>
                        <TextView
                            android:id="@+id/operaio_dett"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.operai}"
                            android:textSize="20sp"
                            android:textColor="@android:color/black"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_modifica_operai"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/modifica"
                            android:textSize="12sp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingVertical="6dp"
                            android:paddingHorizontal="12dp"
                            app:icon="@android:drawable/ic_menu_edit"
                            app:iconSize="14dp"
                            app:iconPadding="4dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/label_fasi_dett"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/fasi"
                        android:textColor="@android:color/black"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:minHeight="20dp"
                        android:progress="@{viewModel.progresso}"
                        android:progressTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_vedi_fasi"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:backgroundTint="@color/primary"
                        android:text="@string/gestisci_fasi"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:icon="@android:drawable/ic_menu_agenda"
                        app:iconGravity="textStart" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:id="@+id/Label_report"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_vedi_report"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/visualizza_report"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        android:backgroundTint="@color/primary"
                        app:icon="@android:drawable/ic_menu_sort_by_size"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>